<mxGraphModel>
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <!-- MainWindow class -->
    <mxCell id="mw" value="" style="swimlane;fontStyle=1;align=center;startSize=26;fontSize=13;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
      <mxGeometry x="220" y="20" width="280" height="220" as="geometry"/>
    </mxCell>
    <mxCell id="mw_title" value="MainWindow" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontStyle=1;fillColor=#F8CECC;" vertex="1" parent="mw">
      <mxGeometry x="0" y="0" width="280" height="26" as="geometry"/>
    </mxCell>
    <mxCell id="mw_attrs" value="-ui: UI_MainWindow&#xa;-m_decodeThread: DecodeThread&#xa;-m_inferenceThread: InferenceThread&#xa;-m_serialWorker: SerialWorker&#xa;-m_classQueue: QQueue&lt;int&gt;&#xa;-m_isDecoding: bool" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;" vertex="1" parent="mw">
      <mxGeometry x="0" y="26" width="280" height="95" as="geometry"/>
    </mxCell>
    <mxCell id="mw_line" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=10;rotatable=0;labelPosition=left;points=[];portConstraint=eastwest;" vertex="1" parent="mw">
      <mxGeometry y="121" width="280" height="8" as="geometry"/>
    </mxCell>
    <mxCell id="mw_methods" value="+onStartStopClicked()&#xa;+onManualIntervene()&#xa;+displayFrame(QImage&amp;)&#xa;+handleInferenceResult(int, float)&#xa;+onSerialStartReceived()" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;" vertex="1" parent="mw">
      <mxGeometry y="129" width="280" height="90" as="geometry"/>
    </mxCell>

    <!-- SerialWorker class -->
    <mxCell id="sw" value="" style="swimlane;fontStyle=1;align=center;startSize=26;fontSize=13;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
      <mxGeometry x="20" y="300" width="220" height="120" as="geometry"/>
    </mxCell>
    <mxCell id="sw_title" value="SerialWorker" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontStyle=1;fillColor=#D5E8D4;" vertex="1" parent="sw">
      <mxGeometry x="0" y="0" width="220" height="26" as="geometry"/>
    </mxCell>
    <mxCell id="sw_attrs" value="-m_serial: SerialPort" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;" vertex="1" parent="sw">
      <mxGeometry x="0" y="26" width="220" height="28" as="geometry"/>
    </mxCell>
    <mxCell id="sw_line" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=10;rotatable=0;labelPosition=left;points=[];portConstraint=eastwest;" vertex="1" parent="sw">
      <mxGeometry y="54" width="220" height="8" as="geometry"/>
    </mxCell>
    <mxCell id="sw_methods" value="+sendClassResponse(int)&#xa;+startCommandReceived()" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;" vertex="1" parent="sw">
      <mxGeometry y="62" width="220" height="48" as="geometry"/>
    </mxCell>

    <!-- DecodeThread class -->
    <mxCell id="dt" value="" style="swimlane;fontStyle=1;align=center;startSize=26;fontSize=13;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
      <mxGeometry x="330" y="300" width="260" height="160" as="geometry"/>
    </mxCell>
    <mxCell id="dt_title" value="DecodeThread" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontStyle=1;fillColor=#D5E8D4;" vertex="1" parent="dt">
      <mxGeometry x="0" y="0" width="260" height="26" as="geometry"/>
    </mxCell>
    <mxCell id="dt_attrs" value="-m_decoder: Decoder&#xa;-m_running: bool" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;" vertex="1" parent="dt">
      <mxGeometry x="0" y="26" width="260" height="38" as="geometry"/>
    </mxCell>
    <mxCell id="dt_line" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=10;rotatable=0;labelPosition=left;points=[];portConstraint=eastwest;" vertex="1" parent="dt">
      <mxGeometry y="64" width="260" height="8" as="geometry"/>
    </mxCell>
    <mxCell id="dt_methods" value="+startDecode(QString)&#xa;+stopDecode()&#xa;+frameDecoded(AVFrame)&#xa;+frameDecodedForDisplay(QImage&amp;)" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;" vertex="1" parent="dt">
      <mxGeometry y="72" width="260" height="78" as="geometry"/>
    </mxCell>

    <!-- InferenceThread class -->
    <mxCell id="it" value="" style="swimlane;fontStyle=1;align=center;startSize=26;fontSize=13;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
      <mxGeometry x="330" y="510" width="260" height="120" as="geometry"/>
    </mxCell>
    <mxCell id="it_title" value="InferenceThread" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontStyle=1;fillColor=#E1D5E7;" vertex="1" parent="it">
      <mxGeometry x="0" y="0" width="260" height="26" as="geometry"/>
    </mxCell>
    <mxCell id="it_attrs" value="-m_frameQueue: QQueue&lt;AVFrame*&gt;&#xa;-m_modelLoader: RKNNModelLoader" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;" vertex="1" parent="it">
      <mxGeometry x="0" y="26" width="260" height="38" as="geometry"/>
    </mxCell>
    <mxCell id="it_line" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=10;rotatable=0;labelPosition=left;points=[];portConstraint=eastwest;" vertex="1" parent="it">
      <mxGeometry y="64" width="260" height="8" as="geometry"/>
    </mxCell>
    <mxCell id="it_methods" value="+enqueueFrame(AVFrame*)&#xa;+inferenceResultReady(int, float)" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;" vertex="1" parent="it">
      <mxGeometry y="72" width="260" height="40" as="geometry"/>
    </mxCell>

    <!-- Arrows with labels -->
    <!-- MainWindow controls SerialWorker -->
    <mxCell id="e1" value="控制" style=" endArrow=classic;html=1;fontSize=11;curved=1;entryX=0.5;entryY=0;exitX=0;exitY=0.5;" edge="1" parent="1" source="mw" target="sw">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- MainWindow controls DecodeThread -->
    <mxCell id="e2" value="控制" style=" endArrow=classic;html=1;fontSize=11;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="mw" target="dt">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- DecodeThread sends AVFrame to InferenceThread -->
    <mxCell id="e3" value="AVFrame数据流" style=" endArrow=classic;html=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="dt" target="it">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- InferenceThread sends results back to MainWindow -->
    <mxCell id="e4" value="推理结果" style=" endArrow=classic;html=1;fontSize=11;curved=1;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="it" target="mw">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="620" y="510"/>
          <mxPoint x="620" y="130"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <!-- SerialWorker sends串口指令 to MainWindow -->
    <mxCell id="e5" value="串口指令" style=" endArrow=classic;html=1;fontSize=11;curved=1;exitX=0.25;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="sw" target="mw">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- MainWindow displays -->
    <mxCell id="e6" value="显示" style=" endArrow=classic;html=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="dt" target="mw">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

  </root>
</mxGraphModel>