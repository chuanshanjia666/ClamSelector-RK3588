<mxGraphModel>
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <!-- Title -->
    <mxCell id="title" value="嵌赛整体组成" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#333333;" vertex="1" parent="1">
      <mxGeometry x="300" y="10" width="200" height="35" as="geometry"/>
    </mxCell>

    <!-- ===== 模型推理 (top center) ===== -->
    <mxCell id="model_infer" value="模型推理" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="320" y="70" width="160" height="50" as="geometry"/>
    </mxCell>

    <!-- ===== 摄像头输入 (left) ===== -->
    <mxCell id="camera" value="摄像头输入" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="190" width="140" height="50" as="geometry"/>
    </mxCell>

    <!-- ===== RK3588 (center) ===== -->
    <mxCell id="rk3588" value="RK3588" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="320" y="185" width="160" height="60" as="geometry"/>
    </mxCell>

    <!-- ===== 显示界面 (right) ===== -->
    <mxCell id="display" value="显示界面" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="620" y="190" width="140" height="50" as="geometry"/>
    </mxCell>

    <!-- ===== 光电传感器 (bottom-left) ===== -->
    <mxCell id="photo_sensor" value="光电传感器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="340" width="140" height="50" as="geometry"/>
    </mxCell>

    <!-- ===== 下位机 (bottom-center) ===== -->
    <mxCell id="mcu" value="下位机" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="320" y="340" width="160" height="50" as="geometry"/>
    </mxCell>

    <!-- ===== 工控按钮输入 (bottom-right) ===== -->
    <mxCell id="btn_input" value="工控按钮输入" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="620" y="340" width="140" height="50" as="geometry"/>
    </mxCell>

    <!-- ===== 直流电机 (bottom-left-lower) ===== -->
    <mxCell id="dc_motor" value="直流电机" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="130" y="460" width="140" height="50" as="geometry"/>
    </mxCell>

    <!-- ===== 步进电机 (bottom-right-lower) ===== -->
    <mxCell id="stepper" value="步进电机" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="490" y="460" width="140" height="50" as="geometry"/>
    </mxCell>

    <!-- ===== Arrows ===== -->
    <!-- 模型推理 <-> RK3588 (双向) -->
    <mxCell id="a1" style="endArrow=classic;startArrow=classic;html=1;" edge="1" parent="1" source="model_infer" target="rk3588">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- 摄像头输入 -> RK3588 -->
    <mxCell id="a2" style="endArrow=classic;html=1;" edge="1" parent="1" source="camera" target="rk3588">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- RK3588 -> 显示界面 -->
    <mxCell id="a3" style="endArrow=classic;html=1;" edge="1" parent="1" source="rk3588" target="display">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- RK3588 <-> 下位机 RS422 (双向) -->
    <mxCell id="a4" value="RS422" style="endArrow=classic;startArrow=classic;html=1;fontSize=11;fontStyle=1;" edge="1" parent="1" source="rk3588" target="mcu">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- 光电传感器 -> 下位机 -->
    <mxCell id="a5" style="endArrow=classic;html=1;" edge="1" parent="1" source="photo_sensor" target="mcu">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- 工控按钮输入 -> 下位机 -->
    <mxCell id="a6" style="endArrow=classic;html=1;" edge="1" parent="1" source="btn_input" target="mcu">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- 下位机 -> 直流电机 PID闭环 -->
    <mxCell id="a7" value="PID闭环" style="endArrow=classic;html=1;fontSize=10;fontStyle=1;" edge="1" parent="1" source="mcu" target="dc_motor">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- 下位机 -> 步进电机 CAN总线 -->
    <mxCell id="a8" value="CAN总线" style="endArrow=classic;html=1;fontSize=10;fontStyle=1;" edge="1" parent="1" source="mcu" target="stepper">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

  </root>
</mxGraphModel>