<mxGraphModel>
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <!-- Title -->
    <mxCell id="title" value="QT信号槽图" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#333333;" vertex="1" parent="1">
      <mxGeometry x="300" y="10" width="200" height="35" as="geometry"/>
    </mxCell>

    <!-- ===== SerialWorker group (left) ===== -->
    <mxCell id="sw_group" value="SerialWorker" style="swimlane;fontStyle=1;align=center;startSize=26;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;rounded=1;" vertex="1" parent="1">
      <mxGeometry x="30" y="55" width="240" height="480" as="geometry"/>
    </mxCell>
    <mxCell id="sw_recv" value="串口数据接收" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="70" y="90" width="160" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="sw_start_cmd" value="startCommandReceived" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="70" y="140" width="160" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="sw_on_serial" value="onSerialStartReceived" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="70" y="220" width="160" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="sw_send_resp" value="sendClassResponse" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="70" y="310" width="160" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="sw_send" value="串口数据发送" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="70" y="370" width="160" height="30" as="geometry"/>
    </mxCell>

    <!-- sw arrows -->
    <mxCell id="sw_a1" style="endArrow=classic;html=1;" edge="1" parent="1" source="sw_recv" target="sw_start_cmd">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="sw_a2" style="endArrow=classic;html=1;" edge="1" parent="1" source="sw_start_cmd" target="sw_on_serial">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="sw_a3" style="endArrow=classic;html=1;" edge="1" parent="1" source="sw_on_serial" target="sw_send_resp">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="sw_a4" style="endArrow=classic;html=1;" edge="1" parent="1" source="sw_send_resp" target="sw_send">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- ===== MainWindow group (top-right) ===== -->
    <mxCell id="mw_group" value="MainWindow" style="swimlane;fontStyle=1;align=center;startSize=26;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;rounded=1;" vertex="1" parent="1">
      <mxGeometry x="320" y="55" width="400" height="120" as="geometry"/>
    </mxCell>
    <mxCell id="mw_start_btn" value="开始/停止按钮" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="340" y="90" width="120" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="mw_manual_btn" value="人工干预按钮" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="540" y="90" width="120" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="mw_on_start" value="onStartStopClicked" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="340" y="130" width="120" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="mw_on_manual" value="onManualIntervene" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="540" y="130" width="120" height="30" as="geometry"/>
    </mxCell>

    <!-- mw arrows -->
    <mxCell id="mw_a1" value="clicked" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="mw_start_btn" target="mw_on_start">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="mw_a2" value="clicked" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="mw_manual_btn" target="mw_on_manual">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- ===== DecodeThread group (middle-right) ===== -->
    <mxCell id="dt_group" value="DecodeThread" style="swimlane;fontStyle=1;align=center;startSize=26;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;rounded=1;" vertex="1" parent="1">
      <mxGeometry x="320" y="200" width="400" height="170" as="geometry"/>
    </mxCell>
    <mxCell id="dt_display" value="frameDecodedForDisplay" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="340" y="240" width="150" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="dt_frame" value="frameDecoded" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="540" y="240" width="150" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="dt_display_fn" value="displayFrame" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="340" y="290" width="150" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="dt_enqueue" value="enqueueFrame" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="540" y="290" width="150" height="30" as="geometry"/>
    </mxCell>

    <!-- dt arrows -->
    <mxCell id="dt_a1" value="QImage" style="endArrow=classic;html=1;fontSize=10;fontColor=#0066CC;" edge="1" parent="1" source="dt_display" target="dt_display_fn">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="dt_a2" value="AVFrame数据" style="endArrow=classic;html=1;fontSize=10;fontColor=#0066CC;" edge="1" parent="1" source="dt_frame" target="dt_enqueue">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- ===== InferenceThread group (bottom-right) ===== -->
    <mxCell id="it_group" value="InferenceThread" style="swimlane;fontStyle=1;align=center;startSize=26;fontSize=13;fillColor=#F8CECC;strokeColor=#B85450;rounded=1;" vertex="1" parent="1">
      <mxGeometry x="370" y="410" width="300" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="it_infer" value="推理处理" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="420" y="445" width="150" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="it_result" value="inferenceResultReady" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="420" y="490" width="150" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="it_a1" style="endArrow=classic;html=1;" edge="1" parent="1" source="it_infer" target="it_result">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- ===== QLabel显示 (bottom) ===== -->
    <mxCell id="qlabel" value="QLabel显示" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="340" y="560" width="160" height="30" as="geometry"/>
    </mxCell>

    <!-- ===== handleInferenceResult & labels (bottom-right) ===== -->
    <mxCell id="handle" value="handleInferenceResult" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="560" y="560" width="160" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="label_conf" value="置信度Label" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="510" y="610" width="90" height="25" as="geometry"/>
    </mxCell>
    <mxCell id="label_cls" value="类别Label" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="620" y="610" width="90" height="25" as="geometry"/>
    </mxCell>
    <mxCell id="handle_a1" style="endArrow=classic;html=1;" edge="1" parent="1" source="handle" target="label_conf">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="handle_a2" style="endArrow=classic;html=1;" edge="1" parent="1" source="handle" target="label_cls">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- ===== Cross-group connections ===== -->
    <!-- startCommandReceived -> onSerialStartReceived -->
    <mxCell id="cross1" value="触发统计" style="endArrow=classic;html=1;fontSize=10;curved=1;fontColor=#CC0000;exitX=0.5;exitY=1;entryX=0;entryY=0;" edge="1" parent="1" source="sw_start_cmd" target="sw_on_serial">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- sendClassResponse -> onSerialStartReceived -->
    <mxCell id="cross2" value="发送结果" style="endArrow=classic;html=1;fontSize=10;curved=1;fontColor=#CC0000;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="sw_on_serial" target="sw_send_resp">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- mw_on_start -> DecodeThread (启动停止) -->
    <mxCell id="cross3" value="启动停止" style="endArrow=classic;html=1;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="mw_on_start" target="dt_group">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- dt_display -> qlabel -->
    <mxCell id="cross4" style="endArrow=classic;html=1;exitX=0;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="dt_display_fn" target="qlabel">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- dt_enqueue -> it_infer -->
    <mxCell id="cross5" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="dt_enqueue" target="it_infer">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- it_result -> handle -->
    <mxCell id="cross6" value="分类结果" style="endArrow=classic;html=1;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontColor=#CC0000;" edge="1" parent="1" source="it_result" target="handle">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

  </root>
</mxGraphModel>